# Treat Godot text resources as text for diffs
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.uid text eol=lf

# Pixel art should not be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
